#!/usr/bin/env python3
"""vault-collect -- drain the outbox repo into the vault. Runs on the Mac only.

    vault-collect              pull, then file anything new
    vault-collect --dry-run    show what would move
    vault-collect --no-pull    skip the git pull

The outbox is append-only from the clusters and your Mac never writes to it,
so the pull is always a fast-forward and cannot conflict. The vault itself is
never in git: iCloud stays the only thing that writes it.

A note you have edited in Obsidian is never overwritten. If the cluster has
also appended to it since, the file is reported and left alone for you.

    VAULT    default ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/obsidian
    OUTBOX   default ~/vault-outbox
"""
import argparse, hashlib, json, os, shutil, subprocess, sys

VAULT = os.path.expanduser(os.environ.get(
    "VAULT", "~/Library/Mobile Documents/iCloud~md~obsidian/Documents/obsidian"))
OUTBOX = os.path.expanduser(os.environ.get("OUTBOX", "~/vault-outbox"))
STATE = os.path.join(VAULT, "_Agents", ".collect-state.json")


def digest(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()[:16]


def dest_for(name):
    if name.endswith(" day.md"):
        return os.path.join(VAULT, "_Agents", "inbox", name)
    return os.path.join(VAULT, "21 RUNS", name)


def main():
    ap = argparse.ArgumentParser(prog="vault-collect", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-pull", action="store_true")
    a = ap.parse_args()

    if not os.path.isdir(VAULT):
        sys.exit("vault not found: %s" % VAULT)
    if not os.path.isdir(OUTBOX):
        sys.exit("outbox not found: %s" % OUTBOX)

    if not a.no_pull and os.path.isdir(os.path.join(OUTBOX, ".git")):
        r = subprocess.run(["git", "-C", OUTBOX, "pull", "--ff-only", "-q"],
                           capture_output=True, text=True)
        if r.returncode:
            print("pull failed:\n%s" % (r.stderr.strip() or r.stdout.strip()), file=sys.stderr)
            print("the outbox should only ever be added to; if this conflicts, something "
                  "wrote to it from the Mac.", file=sys.stderr)
            return 1

    try:
        state = json.load(open(STATE))
    except Exception:
        state = {}

    new, updated, skipped, held = [], [], [], []
    for src in sorted(x for x in os.listdir(OUTBOX) if x.endswith(".md")):
        s = os.path.join(OUTBOX, src)
        d = dest_for(src)
        sd = digest(s)
        if sd == state.get(src):
            skipped.append(src); continue
        if not os.path.exists(d):
            new.append((s, d, src, sd)); continue
        if digest(d) == state.get(src + "@vault"):
            updated.append((s, d, src, sd))          # vault copy untouched since last time
        else:
            held.append(src)                          # you edited it; leave it alone

    for s, d, name, sd in new + updated:
        if a.dry_run:
            continue
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.copy2(s, d)
        state[name] = sd
        state[name + "@vault"] = digest(d)

    if not a.dry_run:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        json.dump(state, open(STATE, "w"), indent=1, sort_keys=True)

    verb = "would file" if a.dry_run else "filed"
    print("%s %d new, %d updated  (%d unchanged)" % (verb, len(new), len(updated), len(skipped)))
    for _, _, n, _ in new:
        print("  new      %s" % n)
    for _, _, n, _ in updated:
        print("  updated  %s" % n)
    for n in held:
        print("  HELD     %s  (you edited the vault copy; cluster version left in the outbox)" % n)
    return 0


sys.exit(main())
