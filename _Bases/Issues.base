filters:
  and:
    - '!file.path.contains("_Templates")'
    - '!file.path.contains("_Archive")'
    - type == "issue"
formulas:
  Logged: if(created, created.format("YYYY.MM.DD"), "")
properties:
  note.system:
    displayName: System
  note.symptom:
    displayName: Symptom
  note.status:
    displayName: Status
  note.project:
    displayName: Project
views:
  - type: table
    name: All
    order:
      - file.name
      - system
      - symptom
      - status
      - formula.Logged
    sort:
      - property: created
        direction: DESC
    columnSize:
      file.name: 260
      note.symptom: 420
  - type: table
    name: Unsolved
    filters:
      and:
        - status != "solved"
    order:
      - file.name
      - system
      - symptom
      - status
      - formula.Logged
    sort:
      - property: created
        direction: DESC
  - type: table
    name: By system
    order:
      - system
      - file.name
      - symptom
      - status
    sort:
      - property: system
        direction: ASC
  - type: table
    name: This project
    filters:
      and:
        - project.contains(this.key)
    order:
      - file.name
      - system
      - symptom
      - status
    sort:
      - property: created
        direction: DESC
