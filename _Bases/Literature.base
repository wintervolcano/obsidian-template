filters:
  and:
    - '!file.path.contains("_Templates")'
    - '!file.path.contains("_Archive")'
    - type == "literature"
properties:
  note.title:
    displayName: Title
  note.authors:
    displayName: Authors
  note.year:
    displayName: Year
views:
  - type: table
    name: All
    order:
      - file.name
      - title
      - authors
      - year
      - tags
    sort:
      - property: year
        direction: DESC
    columnSize:
      file.name: 200
      note.title: 340
      note.authors: 260
  - type: table
    name: To read
    filters:
      and:
        - tags.containsAny("to-read", "unread", "reading")
    order:
      - file.name
      - title
      - authors
      - year
    sort:
      - property: year
        direction: DESC
    limit: 10
